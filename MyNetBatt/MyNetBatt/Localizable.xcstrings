    "技術細節": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical Details"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技術細節"
          }
        }
      }
    },
    "技術細節包括支援的傳輸方式、插拔次數、過電流次數與線材識別碼。選單列的連接埠小視窗只列出使用中的連接埠。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical details include supported transports, plug count, overcurrent count and the cable’s ID. The Ports menu bar window only lists ports in use."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技術細節包括支援的傳輸方式、插拔次數、過電流次數與線材識別碼。選單列的連接埠小視窗只列出使用中的連接埠。"
          }
        }
      }
    },
    "技術細節新增硬體重設、短路偵測、通訊錯誤與角色切換失敗次數。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical details now include hard resets, short-circuit detections, communication errors and role swap failures."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
