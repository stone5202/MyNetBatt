      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collecting: %lld readings so far, current range %@ A. macOS updates input voltage and current about once a minute; at least 5 readings spanning 1 A or more are needed (for example, idle first, then run a heavy task)."
          }
